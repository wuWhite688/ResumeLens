# Copy to compose.env, fill every required value, and pass it with:
# docker compose --env-file compose.env up --build
# Required: Compose refuses to start when any of these values is empty.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# The default Compose profile uses the offline AI mock.
AI_MOCK_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Leave false for http://127.0.0.1:3000. Set true only when the browser uses HTTPS.
# The frontend proxy also adds Secure when it receives an https:// request.
REFRESH_COOKIE_SECURE=false
